DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Production-only overrides — leave unset in dev, all default correctly off
# while DEBUG=True. Set these (and DEBUG=False, real ALLOWED_HOSTS) once
# TLS is actually in place in front of this app:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# DATABASE_URL=postgres://user:password@host:5432/dbname
